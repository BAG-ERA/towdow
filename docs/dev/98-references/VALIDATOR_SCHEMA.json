{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "x-flowit-validator Schema",
  "type": "array",
  "items": {
    "type": "array",
    "items": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "type": { "type": "string", "enum": ["checklist"] },
            "required": { "type": "boolean" },
            "title": { "type": "string" },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "text": { "type": "string" },
                  "checked": { "type": "boolean", "default": false }
                },
                "required": ["id", "text", "checked"],
                "additionalProperties": false
              }
            }
          },
          "required": ["id", "type", "required", "title", "items"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "type": { "type": "string", "enum": ["single_select"] },
            "required": { "type": "boolean" },
            "title": { "type": "string" },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "text": { "type": "string" }
                },
                "required": ["id", "text"],
                "additionalProperties": false
              }
            },
            "selected": { "type": "string", "default": "" }
          },
          "required": ["id", "type", "required", "title", "options", "selected"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "type": { "type": "string", "enum": ["free_field"] },
            "required": { "type": "boolean" },
            "title": { "type": "string" },
            "value": { "type": "string", "default": "" },
            "helper": { "type": "string", "default": "" }
          },
          "required": ["id", "type", "required", "title", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "type": { "type": "string", "enum": ["file"] },
            "required": { "type": "boolean" },
            "title": { "type": "string" },
            "files": { "type": "array", "default": [] },
            "encryptionKey": { "type": "string" },
            "helper": { "type": "string", "default": "" }
          },
          "required": ["id", "type", "required", "title", "files", "encryptionKey"],
          "additionalProperties": false
        }
      ]
    }
  }
}
