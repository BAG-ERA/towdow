    <project_license>AGPL-3.0-or-later</project_license>

    <developer_name>BAG-ERA</developer_name>
    <url type="homepage">https://towdow.app/</url>
    <url type="bugtracker">https://gitlab.com/towdow/towdow-flutter/-/issues</url>
<!--    <url type="help">https://towdow.app/docs</url>-->
<!--    <url type="donation">https://towdow.app/donate</url>-->

    <categories>
        <category>Utility</category>
        <category>Office</category>
    </categories>

    <keywords>
        <keyword>task</keyword>
        <keyword>todo</keyword>
        <keyword>workflow</keyword>
        <keyword>project</keyword>
    </keywords>

